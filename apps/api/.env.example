# Server
PORT=5174
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Supabase — from Project Settings → API in the Supabase dashboard.
# Leave blank to run the API in fallback mode (seed content, in-memory submissions).
SUPABASE_URL=
# Service role key. Server-side ONLY — it bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where enquiry notifications are delivered
NOTIFY_EMAIL=info@makutano.co.tz

# Resend — https://resend.com/api-keys. With this set, every enquiry is emailed
# to NOTIFY_EMAIL with the sender set as reply-to. Leave blank to disable.
RESEND_API_KEY=
# Must be an address on a domain verified at https://resend.com/domains.
# The default test sender only delivers to the Resend account owner's own
# address, so set a real one before relying on this.
RESEND_FROM=Makutano Digital <website@makutano.co.tz>
